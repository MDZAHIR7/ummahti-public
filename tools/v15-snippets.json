  "head": "\r\n<meta charset=\"utf-8\">\r\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\r\n<title>Ummahti: One Ummah, connected by the Quran</title>\r\n<meta name=\"description\" content=\"Ummahti brings us closer to the Quran through recitations, reminders and Ummahti Quran, our free Android app for reading, understanding and memorising.\">\r\n<meta name=\"theme-color\" content=\"#08080a\">\r\n<link rel=\"canonical\" href=\"https://ummahtiofficial.com/\">\r\n\r\n\r\n<link rel=\"icon\" href=\"/media/brand/2026-10/favicon-48.png\" type=\"image/png\" sizes=\"48x48\">\r\n<link rel=\"icon\" href=\"/media/brand/2026-10/favicon.ico\" sizes=\"16x16 32x32 48x48\">\r\n<link rel=\"icon\" href=\"/media/brand/2026-10/favicon-32.png\" type=\"image/png\" sizes=\"32x32\">\r\n<link rel=\"icon\" href=\"/media/brand/2026-10/favicon-16.png\" type=\"image/png\" sizes=\"16x16\">\r\n<link rel=\"apple-touch-icon\" href=\"/media/brand/2026-10/apple-touch-icon.png\">\r\n<link rel=\"manifest\" href=\"/site.webmanifest\">\r\n\r\n<meta property=\"og:type\" content=\"website\">\r\n<meta property=\"og:site_name\" content=\"Ummahti\">\r\n<meta property=\"og:title\" content=\"Ummahti: One Ummah, connected by the Quran\">\r\n<meta property=\"og:description\" content=\"A shared purpose. A closer connection to the Quran. Discover Ummahti, our free Quran app, recitations and reminders.\">\r\n<meta property=\"og:url\" content=\"https://ummahtiofficial.com/\">\r\n<meta property=\"og:image\" content=\"https://ummahtiofficial.com/media/brand/2026-10/og.jpg\">\r\n<meta property=\"og:image:width\" content=\"1200\">\r\n<meta property=\"og:image:height\" content=\"630\">\r\n<meta property=\"og:locale\" content=\"en\">\r\n<meta name=\"twitter:card\" content=\"summary_large_image\">\r\n\r\n<script type=\"application/ld+json\">\r\n{\r\n \"@context\":\"https://schema.org\",\r\n \"@graph\":[\r\n  {\"@type\":\"Organization\",\"@id\":\"https://ummahtiofficial.com/#organi