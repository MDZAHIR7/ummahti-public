google.com/store/apps/details?id=com.ummahti.quran\",\"publisher\":{\"@id\":\"https://ummahtiofficial.com/#organization\"},\"isAccessibleForFree\":true,\"offers\":{\"@type\":\"Offer\",\"price\":\"0\",\"priceCurrency\":\"USD\"}}\r\n ]\r\n}\r\n</script>\r\n\r\n<script type=\"application/ld+json\">\r\n{\r\n  \"@context\": \"https://schema.org\",\r\n  \"@type\": \"VideoObject\",\r\n  \"name\": \"The Ummahti Quran film\",\r\n  \"description\": \"The prayer behind the name, then the app itself: Ummahti Guide and its sources, the Mushaf page, seven calligraphy styles, the heritage themes, recitation from a choice of reciters, and Ayah on Unlock. No ads, no account, free.\",\r\n  \"thumbnailUrl\": \"https://ummahtiofficial.com/media/film/ummahti-ad-v4-land.webp\",\r\n  \"contentUrl\": \"https://ummahtiofficial.com/media/film/ummahti-ad-v4-land.h264.mp4\",\r\n  \"uploadDate\": \"2026-09-28\",\r\n  \"duration\": \"PT1M50S\",\r\n  \"inLanguage\": \"en\",\r\n  \"isFamilyFriendly\": true,\r\n  \"publisher\": {\r\n    \"@type\": \"Organization\",\r\n    \"name\": \"Ummahti\",\r\n    \"url\": \"https://ummahtiofficial.com/\",\r\n    \"@id\": \"https://ummahtiofficial.com/#organization\"\r\n  }\r\n}\r\n</script>\r\n\r\n<link rel=\"preload\" href=\"/fonts/cinzel-latin.woff2\" as=\"font\" type=\"font/woff2\" crossorigin>\r\n<link rel=\"preload\" href=\"/fonts/jakarta-latin.woff2\" as=\"font\" type=\"font/woff2\" crossorigin>\r\n<link rel=\"stylesheet\" href=\"/styles.css?v=20261017d\">\r\n<link rel=\"stylesheet\" href=\"/hub.css?v=20261017d\">\r\n<link rel=\"stylesheet\" href=\"/editorial.css?v=20261017d\">\r\n<script src=\"/theme.js?v=20260918a\"></script>\r\n",
