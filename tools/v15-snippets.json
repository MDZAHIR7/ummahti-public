         <li role=\"option\" id=\"voice-minshawy_murattal\" data-clip=\"minshawy_murattal\">محمد صدیق المنشاوی <i>(مرتّل)</i></li>\r\n            <li role=\"option\" id=\"voice-minshawy_mujawwad\" data-clip=\"minshawy_mujawwad\">محمد صدیق المنشاوی <i>(مجوّد)</i></li>\r\n            <li role=\"option\" id=\"voice-muhammad_ayyoub\" data-clip=\"muhammad_ayyoub\" data-gain=\"0.72\">محمد ایوب</li>\r\n            <li role=\"option\" id=\"voice-jibreel\" data-clip=\"jibreel\" data-gain=\"0.56\">محمد جبریل</li>\r\n            <li role=\"option\" id=\"voice-sowaid\" data-clip=\"sowaid\">ایمن سوید</li>\r\n            <li role=\"option\" id=\"voice-raad_kurdi\" data-clip=\"raad_kurdi\" data-gain=\"0.95\">راعد الکردی</li>\r\n            <li role=\"option\" id=\"voice-yasser_dosari\" data-clip=\"yasser_dosari\" data-gain=\"0.54\">یاسر الدوسری</li>\r\n            <li role=\"option\" id=\"voice-nasser_qatami\" data-clip=\"nasser_qatami\" data-gain=\"0.57\">ناصر القطامی</li>\r\n            <li role=\"option\" id=\"voice-khalid_jalil\" data-clip=\"khalid_jalil\" data-gain=\"0.98\">خالد الجلیل</li>\r\n            <li role=\"option\" id=\"voice-idris_abkar\" data-clip=\"idris_abkar\">ادریس ابکر</li>\r\n            <li role=\"option\" id=\"voice-fares_abbad\" data-clip=\"fares_abbad\" data-gain=\"0.91\">فارس عباد</li>\r\n            <li role=\"option\" id=\"voice-saad_ghamdi\" data-clip=\"saad_ghamdi\">سعد الغامدی</li>\r\n            <li role=\"option\" id=\"voice-bandar_balila\" data-clip=\"bandar_balila\" data-gain=\"0.73\">بندر بلیلہ</li>\r\n            <li role=\"option\" id=\"voice-mustafa_ismail\" data-clip=\"mustafa_ismail\" data-gain=\"0.38\">مصطفیٰ اسماعیل <i>(مجوّد)</i></li>\r\n            <li role=\"option\" id=\"voice-salah_budair\" data-clip=\"salah_budair\" data-nosite class=\"is-nosite\">صلاح البدیر</li>\r\n            <li role=\"option\" id=\"voice-abdullah_matrood\" data-clip=\"abdullah_matrood\" data-nosite class=\"is-nosite\">عبد اللہ المطرود</li>\r\n            <li 