    "en": "<section class=\"bay verse-lock ed-verse\" id=\"one-verse\" aria-labelledby=\"one-verse-title\"\r\n           data-verse data-clips=\"ready\" hidden data-msg-gone=\"That recitation is not on the site yet.\" data-msg-spin=\"Spin the drum to change the voice.\" data-msg-blocked=\"This browser would not start the audio.\" data-msg-playing=\"Playing.\" data-msg-play=\"Play this verse\" data-msg-pause=\"Pause\">\r\n    <div class=\"shell\">\r\n      <p class=\"label\" data-reveal>One verse</p>\r\n      <h2 class=\"d2\" id=\"one-verse-title\" data-reveal data-split>Hear the ayah of One Ummah.</h2>\r\n\r\n      <div class=\"lock ed-recitation\" data-reveal style=\"--delay:120ms\">\r\n        <figure class=\"lock-verse\">\r\n          <p class=\"ayah\" lang=\"ar\" dir=\"rtl\">&#1573;&#1616;&#1606;&#1617;&#1614; &#1607;&#1614;&#1648;&#1584;&#1616;&#1607;&#1616; &#1571;&#1615;&#1605;&#1617;&#1614;&#1578;&#1615;&#1603;&#1615;&#1605;&#1618; &#1571;&#1615;&#1605;&#1617;&#1614;&#1577;&#1611; &#1608;&#1614;&#1575;&#1581;&#1616;&#1583;&#1614;&#1577;&#1611; &#1608;&#1614;&#1571;&#1614;&#1606;&#1614;&#1575; &#1585;&#1614;&#1576;&#1617;&#1615;&#1603;&#1615;&#1605;&#1618; &#1601;&#1614;&#1575;&#1593;&#1618;&#1576;&#1615;&#1583;&#1615;&#1608;&#1606;&#1616;</p>\r\n          <p class=\"ayah-lat\">Inna h&#257;dhihi ummatukum ummatan w&#257;&#7717;idatan wa-ana rabbukum fa&rsquo;bud&#363;n</p>\r\n          <blockquote class=\"ayah-gloss\">\r\n            <p>&ldquo;Indeed this ummah of yours is one ummah, and I am your Lord, so worship Me.&rdquo;</p>\r\n          </blockquote>\r\n          <figcaption>\r\n            <cite>S&#363;rah Al-Anbiy&#257;&rsquo; 21:92</cite>\r\n            <span>A plain rendering of the meaning, not a named translation.</span>\r\n          </figcaption>\r\n        </figure>\r\n\r\n        <!-- The drum. It is a real scroll container with scroll snapping, so\r\n             the flick, the momentum and the settle are the platform's own and\r\n             feel right on a phone without a line of physics here. The script\r\n             only leans the rows away from the reader and ticks the haptic as\r\n             each name crosses the band. -->\r\n        <div class=\"lock-deck\">\r\n          <div class=\"wheel\" data-wheel>\r\n            <div class=\"wheel-band\" aria-hidden=\"true\"></div>\r\n            <ul class=\"wheel-list\" data-wheel-list\r\n                role=\"listbox\" tabindex=\"0\"\r\n                aria-label=\"Reciter\"\r\n                aria-activedescendant=\"voice-alafasy\">\r\n            <li role=\"option\" id=\"voice-alafasy\" data-clip=\"alafasy\" aria-selected=\"true\">Mishari Rashid Alafasy</li>\r\n            <li role=\"option\" id=\"voice-abdulbaset\" data-clip=\"abdulbaset\">Abdul Basit Abdul Samad</li>\r\n            <li role=\"option\" id=\"voice-abdullah_basfar\" data-clip=\"abdullah_basfar\">Abdullah Basfar</li>\r\n            <li role=\"option\" id=\"voice-sudais\" data-clip=\"sudais\" data-gain=\"0.56\">Abdul Rahman Al-Sudais</li>\r\n            <li role=\"option\" id=\"voice-shuraym\" data-clip=\"shuraym\">Saud Al-Shuraim</li>\r\n            <li role=\"option\" id=\"voice-shatri\" data-clip=\"shatri\">Abu Bakr Al-Shatri</li>\r\n            <li role=\"option\" id=\"voice-ajamy\" data-clip=\"ajamy\" data-gain=\"0.53\">Ahmad bin Ali Al-Ajmi</li>\r\n            <li role=\"option\" id=\"voice-hani_rifai\" data-clip=\"hani_rifai\">Hani Ar-Rifai</li>\r\n            <li role=\"option\" id=\"voice-husary\" data-clip=\"husary\" data-gain=\"0.97\">Mahmoud Khalil Al-Hussary</li>\r\n            <li role=\"option\" id=\"voice-husary_mujawwad\" data-clip=\"husary_mujawwad\">Mahmoud Khalil Al-Hussary <i>(Mujawwad)</i></li>\r\n            <li role=\"option\" id=\"voice-hudhaify\" data-clip=\"hudhaify\" data-gain=\"0.99\">Ali Al-Hudhaify</li>\r\n            <li role=\"option\" id=\"voice-akhdar\" data-clip=\"akhdar\">Ibrahim Al-Akhdar</li>\r\n            <li role=\"option\" id=\"voice-maher_muaiqly\" data-clip=\"maher_muaiqly\">Maher Al-Muaiqly</li>\r\n            <li role=\"option\" id=\"voice-minshawy_murattal\" data-clip=\"minshawy_murattal\">Mohamed Siddiq Al-Minshawi <i>(Murattal)</i></li>\r\n            <li role=\"option\" id=\"voice-muhammad_ayyoub\" data-clip=\"muhammad_ayyoub\" data-gain=\"0.72\">Muhammad Ayyoub</li>\r\n            <li role=\"option\" id=\"voice-jibreel\" data-clip=\"jibreel\" data-gain=\"0.56\">Muhammad Jibril</li>\r\n            <li role=\"option\" id=\"voice-sowaid\" data-clip=\"sowaid\">Ayman Suwaid</li>\r\n            <li role=\"option\" id=\"voice-raad_kurdi\" data-clip=\"raad_kurdi\" data-gain=\"0.95\">Raad Al-Kurdi</li>\r\n            <li role=\"option\" id=\"voice-yasser_dosari\" data-clip=\"yasser_dosari\" data-gain=\"0.54\">Yasser Al-Dosari</li>\r\n            <li role=\"option\" id=\"voice-nasser_qatami\" data-clip=\"nasser_qatami\" data-gain=\"0.57\">Nasser Al-Qatami</li>\r\n            <li role=\"option\" id=\"voice-khalid_jalil\" data-clip=\"khalid_jalil\" data-gain=\"0.98\">Khalid Al-Jalil</li>\r\n            <li role=\"option\" id=\"voice-idris_abkar\" data-clip=\"idris_abkar\">Idris Abkar</li>\r\n            <li role=\"option\" id=\"voice-fares_abbad\" data-clip=\"fares_abbad\" data-gain=\"0.91\">Fares Abbad</li>\r\n            <li role=\"option\" id=\"voice-saad_ghamdi\" data-clip=\"saad_ghamdi\">Saad Al-Ghamdi</li>\r\n            <li role=\"option\" id=\"voice-bandar_balila\" data-clip=\"bandar_balila\" data-gain=\"0.73\">Bandar Balila</li>\r\n            <li role=\"option\" id=\"voice-mustafa_ismail\" data-clip=\"mustafa_ismail\" data-gain=\"0.38\">Mustafa Ismail <i>(Mujawwad)</i></li>\r\n            <li role=\"option\" id=\"voice-salah_budair\" data-clip=\"salah_budair\" data-nosite class=\"is-nosite\">Salah Al-Budair</li>\r\n            <li role=\"option\" id=\"voice-abdullah_matrood\" data-clip=\"abdullah_matrood\" data-nosite class=\"is-nosite\">Abdullah Al-Matrood</li>\r\n            <li role=\"option\" id=\"voice-salah_bukhatir\" data-clip=\"salah_bukhatir\" data-nosite class=\"is-nosite\">Salah Bukhatir</li>\r\n            <li role=\"option\" id=\"voice-banna_mujawwad\" data-clip=\"banna_mujawwad\" data-nosite class=\"is-nosite\">Mahmoud Ali Al-Banna <i>(Mujawwad)</i></li>\r\n            <li role=\"option\" id=\"voice-masarawi\" data-clip=\"masarawi\" data-nosite class=\"is-nosite\">Ahmed Issa Al-Masarawi</li>\r\n            <li role=\"option\" id=\"voice-burhaji\" data-clip=\"burhaji\" data-nosite class=\"is-nosite\">Muhammad Burhaji</li>\r\n            <li role=\"option\" id=\"voice-buayjan\" data-clip=\"buayjan\" data-nosite class=\"is-nosite\">Abdullah Al-Buayjan</li>\r\n            <li role=\"option\" id=\"voice-nufais\" data-clip=\"nufais\" data-nosite class=\"is-nosite\">Ahmad Al-Nufais</li>\r\n            <li role=\"option\" id=\"voice-salemi\" data-clip=\"salemi\" data-nosite class=\"is-nosite\">Mansour Al-Salemi</li>\r\n            <li role=\"option\" id=\"voice-dukhain\" data-clip=\"dukhain\" data-nosite class=\"is-nosite\">Haitham Al-Dukhain</li>\r\n            <li role=\"option\" id=\"voice-hasan_saleh\" data-clip=\"hasan_saleh\" data-nosite class=\"is-nosite\">Hasan Saleh</li>\r\n            </ul>\r\n          </div>\r\n\r\n          <div class=\"lock-controls\">\r\n            <button class=\"lock-play\" type=\"button\" data-play aria-label=\"Play this verse\">\r\n              <svg class=\"i-play\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M8.5 5.6l10 6.4-10 6.4z\" fill=\"currentColor\"/></svg>\r\n              <svg class=\"i-pause\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M8.4 5.4h3v13.2h-3zM12.6 5.4h3v13.2h-3z\" fill=\"currentColor\"/></svg>\r\n            </button>\r\n            <div class=\"lock-meta\">\r\n              <p class=\"lock-now\" data-now>Mishari Rashid Alafasy</p>\r\n              <div class=\"lock-bar\" aria-hidden=\"true\"><i data-bar></i></div>\r\n              <p class=\"lock-hint\" data-hint>Spin the drum to change the voice.</p>\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <audio data-audio preload=\"none\"></audio>\r\n      </div>\r\n    </div>\r\n  </section>",
    "ar": "<section class=\"bay verse-lock\" id=\"one-verse\" aria-labelledby=\"one-verse-title\"\r\n           data-verse data-clips=\"ready\" hidden data-msg-gone=\"هذه التلاوة ليست على الموقع بعد.\" data-msg-spin=\"أدِر القرص لتغيير الصوت.\" data-msg-blocked=\"لم يبدأ هذا المتصفّح تشغيل الصوت.\" data-msg-playing=\"قيد التشغيل.\" data-msg-play=\"شغّل هذه الآية\" data-msg-pause=\"إيقاف مؤقّت\">\r\n    <div class=\"shell\">\r\n      <p class=\"label\" data-reveal>آية واحدة</p>\r\n      <h2 class=\"d2\" id=\"one-verse-title\" data-reveal data-split>استمع إلى الآية التي جاء منها اسمنا.</h2>\r\n\r\n      <div class=\"lock panel\" data-reveal style=\"--delay:120ms\">\r\n        <figure class=\"lock-verse\">\r\n          <p class=\"ayah\" lang=\"ar\" dir=\"rtl\">&#1573;&#1616;&#1606;&#1617;&#1614; &#1607;&#1614;&#1648;&#1584;&#1616;&#1607;&#1616; &#1571;&#1615;&#1605;&#1617;&#1614;&#1578;&#1615;&#1603;&#1615;&#1605;&#1618; &#1571;&#1615;&#1605;&#1617;&#1614;&#1577;&#1611; &#1608;&#1614;&#1575;&#1581;&#1616;&#1583;&#1614;&#1577;&#1611; &#1608;&#1614;&#1571;&#1614;&#1606;&#1614;&#1575; &#1585;&#1614;&#1576;&#1617;&#1615;&#1603;&#1615;&#1605;&#1618; &#1601;&#1614;&#1575;&#1593;&#1618;&#1576;&#1615;&#1583;&#1615;&#1608;&#1606;&#1616;</p>\r\n          <p class=\"ayah-lat\">Inna h&#257;dhihi ummatukum ummatan w&#257;&#7717;idatan wa-ana rabbukum fa&rsquo;bud&#363;n</p>\r\n          <blockquote class=\"ayah-gloss\">\r\n            <p>هذه هي الآية التي أُخذ منها اسم التطبيق. ونصّها العربي يُقرأ في التطبيق، لا في المتصفّح.</p>\r\n          </blockquote>\r\n          <figcaption>\r\n            <cite>سورة الأنبياء ⁦21:92⁩</cite>\r\n            <span>نصّ الآية العربي مقصور على التطبيق، حيث يُرسم بمحارف القرآن المعتمدة فيه.</span>\r\n          </figcaption>\r\n        </figure>\r\n\r\n        <!-- The drum. It is a real scroll container with scroll snapping, so\r\n             the flick, the momentum and the settle are the platform's own and\r\n             feel right on a phone without a line of physics here. The script\r\n             only leans the rows away from the reader and ticks the haptic as\r\n             each name crosses the band. -->\r\n        <div class=\"lock-deck\">\r\n          <div class=\"wheel\" data-wheel>\r\n            <div class=\"wheel-band\" aria-hidden=\"true\"></div>\r\n            <ul class=\"wheel-list\" data-wheel-list\r\n                role=\"listbox\" tabindex=\"0\"\r\n                aria-label=\"Reciter\"\r\n                aria-activedescendant=\"voice-alafasy\">\r\n            <li role=\"option\" id=\"voice-alafasy\" data-clip=\"alafasy\" aria-selected=\"true\">مشاري راشد العفاسي</li>\r\n            <li role=\"option\" id=\"voice-abdulbaset\" data-clip=\"abdulbaset\">عبد الباسط عبد الصمد</li>\r\n            <li role=\"option\" id=\"voice-abdullah_basfar\" data-clip=\"abdullah_basfar\">عبدالله بصفر</li>\r\n            <li role=\"option\" id=\"voice-sudais\" data-clip=\"sudais\" data-gain=\"0.56\">عبد الرحمن السديس</li>\r\n            <li role=\"option\" id=\"voice-shuraym\" data-clip=\"shuraym\">سعود الشريم</li>\r\n            <li role=\"option\" id=\"voice-shatri\" data-clip=\"shatri\">أبو بكر الشاطري</li>\r\n            <li role=\"option\" id=\"voice-ajamy\" data-clip=\"ajamy\" data-gain=\"0.53\">أحمد بن علي العجمي</li>\r\n            <li role=\"option\" id=\"voice-hani_rifai\" data-clip=\"hani_rifai\">هاني الرفاعي</li>\r\n            <li role=\"option\" id=\"voice-husary\" data-clip=\"husary\" data-gain=\"0.97\">محمود خليل الحصري</li>\r\n            <li role=\"option\" id=\"voice-husary_mujawwad\" data-clip=\"husary_mujawwad\">محمود خليل الحصري <i>(مجوَّد)</i></li>\r\n            <li role=\"option\" id=\"voice-hudhaify\" data-clip=\"hudhaify\" data-gain=\"0.99\">علي الحذيفي</li>\r\n            <li role=\"option\" id=\"voice-akhdar\" data-clip=\"akhdar\">ابراهيم الاخضر</li>\r\n            <li role=\"option\" id=\"voice-maher_muaiqly\" data-clip=\"maher_muaiqly\">ماهر المعيقلي</li>\r\n            <li rol